# Neon Postgres pooled connection string (use the pooled URL, not the direct URL)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Shared secret for service-to-service auth (must match INTERNAL_API_KEY in web/.env.local)
INTERNAL_API_KEY=your_internal_shared_secret_here

# Allowed origins for CORS — comma-separated, must be exact production domain(s)
CORS_ORIGINS=https://your-app.vercel.app

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob read/write token (https://vercel.com/storage/blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Optional: rate limits (requests per minute)
RATE_LIMIT_CHAT=10
RATE_LIMIT_REPORTS=5
