# Neon Postgres (use pooled connection string for serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk authentication — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Optional Clerk redirect URLs (defaults work for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob storage — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Python API service (FastAPI)
PYTHON_API_URL=http://localhost:8000

# Shared secret for service-to-service auth (must match api/.env)
INTERNAL_API_KEY=your_internal_shared_secret_here
