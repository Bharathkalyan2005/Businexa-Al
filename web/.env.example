# Neon Postgres (use pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk Auth — get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_key_here
CLERK_SECRET_KEY=sk_live_your_key_here

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Vercel Blob — get from https://vercel.com/storage/blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Python API service URL (Render/Railway production URL)
PYTHON_API_URL=https://your-python-api.onrender.com

# Shared secret — must match INTERNAL_API_KEY in api/.env
INTERNAL_API_KEY=your_internal_shared_secret_here
